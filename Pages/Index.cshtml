@page
@model IndexModel
@{ ViewData["Title"] = "Accueil"; }

<div class="container mt-4">
    <div class="p-4 bg-light rounded-3 border mb-4">
        <h1 class="text-primary">@Model.MessageAccueil</h1>
        <p class="text-muted">Date serveur : @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    <h3>Programme d'apprentissage :</h3>
    <ul class="list-group">
        @foreach (var module in Model.Modules)
        {
            <li class="list-group-item">✔ @module</li>
        }
    </ul>
</div>